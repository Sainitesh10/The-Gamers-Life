generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  avatarUrl  String
  playstyle  String
  rank       String
  bio        String
  topGames   Game[]
  
  matchesInitiated Match[] @relation("UserAMatches")
  matchesReceived  Match[] @relation("UserBMatches")
  messages         Message[]
  
  createdAt  DateTime @default(now())
}

model Game {
  id      Int    @id @default(autoincrement())
  name    String
  users   User[]
}

model Match {
  id        String   @id @default(uuid())
  userAId   Int
  userBId   Int
  userA     User     @relation("UserAMatches", fields: [userAId], references: [id])
  userB     User     @relation("UserBMatches", fields: [userBId], references: [id])
  
  status    String   @default("CHATTING") // CHATTING, REVEALED
  
  messages  Message[]
  quest     Quest?
  
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  text      String
  
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  senderId  Int
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Quest {
  id          Int      @id @default(autoincrement())
  description String
  isCompleted Boolean  @default(false)
  
  matchId     String   @unique
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
